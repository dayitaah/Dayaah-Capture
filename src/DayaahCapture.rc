#define RT_MANIFEST 24
#define IDI_DAYAAH 101
#define IDI_DAYAAH_HEADER 102

1 RT_MANIFEST "DayaahCapture.manifest"
IDI_DAYAAH ICON "DayaahCapture.ico"
IDI_DAYAAH_HEADER ICON "DayaahCapture-header.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Dayaah"
            VALUE "FileDescription", "Dayaah Capture"
            VALUE "FileVersion", "1.0"
            VALUE "InternalName", "DayaahCapture"
            VALUE "LegalCopyright", "Copyright (c) 2026 Dayaah"
            VALUE "OriginalFilename", "DayaahCapture.exe"
            VALUE "ProductName", "Dayaah Capture"
            VALUE "ProductVersion", "1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
